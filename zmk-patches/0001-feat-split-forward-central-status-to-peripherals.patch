 const struct zmk_split_transport_central *active_transport;
@@ -150,6 +165,107 @@ int zmk_split_central_update_hid_indicator(zmk_hid_indicators_t indicators) {
 
 #endif // IS_ENABLED(CONFIG_ZMK_SPLIT_PERIPHERAL_HID_INDICATORS)
 
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_PERIPHERAL_STATUS_REPORTING)
+
+int zmk_split_central_broadcast_peripheral_status(void) {
+    if (!active_transport || !active_transport->api ||
+        !active_transport->api->get_available_source_ids || !active_transport->api->send_command) {
+        return -ENODEV;
+    }
+
+    uint8_t source_ids[ZMK_SPLIT_CENTRAL_PERIPHERAL_COUNT];
+
+    int ret = active_transport->api->get_available_source_ids(source_ids);
+    if (ret < 0) {
+        return ret;
+    }
+
+    const size_t available = (size_t)ret;
+
+    struct zmk_split_transport_central_command command =
+        (struct zmk_split_transport_central_command){
+            .type = ZMK_SPLIT_TRANSPORT_CENTRAL_CMD_TYPE_SET_PERIPHERAL_STATUS,
+            .data = {.set_peripheral_status = {
+                         .layer_index = zmk_keymap_highest_layer_active(),
+                         .endpoint_transport = zmk_endpoint_get_selected().transport,
+                     }},
+        };
+
+#if IS_ENABLED(CONFIG_ZMK_BLE)
+    command.data.set_peripheral_status.active_profile_index = zmk_ble_active_profile_index();
+    if (zmk_ble_active_profile_is_connected()) {
+        command.data.set_peripheral_status.profile_flags |= ZMK_SPLIT_STATUS_PROFILE_CONNECTED;
+    }
+    if (!zmk_ble_active_profile_is_open()) {
+        command.data.set_peripheral_status.profile_flags |= ZMK_SPLIT_STATUS_PROFILE_BONDED;
+    }
+#endif // IS_ENABLED(CONFIG_ZMK_BLE)
+
+#if IS_ENABLED(CONFIG_ZMK_WPM)
+    command.data.set_peripheral_status.wpm = (uint8_t)CLAMP(zmk_wpm_get_state(), 0, UINT8_MAX);
+#endif // IS_ENABLED(CONFIG_ZMK_WPM)
+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING)
+    // peripheral_battery_levels is sized by the (config dependent) peripheral count, the
+    // payload by the fixed wire constant. Copy whichever is smaller and leave the rest zeroed.
+    const size_t battery_count =
+        MIN(ARRAY_SIZE(peripheral_battery_levels), ZMK_SPLIT_STATUS_MAX_PERIPHERALS);
+    memcpy(command.data.set_peripheral_status.battery_levels, peripheral_battery_levels,
+           battery_count);
+#endif // IS_ENABLED(CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING)
+
+    for (size_t i = 0; i < available; i++) {
+        // get_available_source_ids only returns connected peripherals, so the array index
+        // is not the source id. Tell each peripheral its own id, so it can pick its own
+        // entry out of battery_levels.
+        command.data.set_peripheral_status.source = source_ids[i];
+
+        int send_ret = active_transport->api->send_command(source_ids[i], command);
+        if (send_ret < 0) {
+            LOG_WRN("Failed to send status to peripheral %d (%d)", source_ids[i], send_ret);
+            ret = send_ret;
+        }
+    }
+
+    return ret < 0 ? ret : 0;
+}
+
+static void peripheral_status_broadcast_work_cb(struct k_work *work) {
+    zmk_split_central_broadcast_peripheral_status();
+
+    struct k_work_delayable *dwork = k_work_delayable_from_work(work);
+    k_work_schedule_for_queue(zmk_workqueue_lowprio_work_q(), dwork,
+                              K_SECONDS(CONFIG_ZMK_SPLIT_PERIPHERAL_STATUS_INTERVAL_S));
+}
+
+static K_WORK_DELAYABLE_DEFINE(peripheral_status_broadcast_work,
+                               peripheral_status_broadcast_work_cb);
+
+// Battery levels and WPM ride the periodic tick rather than their own events: WPM changes
+// once a second, and a BLE write plus an ePaper refresh at that rate is not worth it.
+static int peripheral_status_broadcast_init(void) {
+    k_work_schedule_for_queue(zmk_workqueue_lowprio_work_q(), &peripheral_status_broadcast_work,
+                              K_SECONDS(CONFIG_ZMK_SPLIT_PERIPHERAL_STATUS_INTERVAL_S));
+    return 0;
+}
+
+SYS_INIT(peripheral_status_broadcast_init, APPLICATION, CONFIG_APPLICATION_INIT_PRIORITY);
+
+// Layer and endpoint changes are pushed immediately; they have to feel instant.
+static int peripheral_status_listener_cb(const zmk_event_t *eh) {
+    zmk_split_central_broadcast_peripheral_status();
+    return ZMK_EV_EVENT_BUBBLE;
+}
+
+ZMK_LISTENER(peripheral_status_listener, peripheral_status_listener_cb);
+ZMK_SUBSCRIPTION(peripheral_status_listener, zmk_layer_state_changed);
+ZMK_SUBSCRIPTION(peripheral_status_listener, zmk_endpoint_changed);
+#if IS_ENABLED(CONFIG_ZMK_BLE)
+ZMK_SUBSCRIPTION(peripheral_status_listener, zmk_ble_active_profile_changed);
+#endif
+
+#endif // IS_ENABLED(CONFIG_ZMK_SPLIT_PERIPHERAL_STATUS_REPORTING)
+
