--- /dev/null
+++ b/app/include/zmk/events/split_peripheral_status_data_changed.h
@@ -0,0 +1,27 @@
+/*
+ * Copyright (c) 2025 The ZMK Contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include <zephyr/kernel.h>
+#include <zmk/event_manager.h>
+#include <zmk/split/transport/types.h>
+
+// Status forwarded from the central to a peripheral. Raised on the peripheral when a
+// ZMK_SPLIT_TRANSPORT_CENTRAL_CMD_TYPE_SET_PERIPHERAL_STATUS command arrives.
+struct zmk_split_peripheral_status_data_changed {
+    // This peripheral's own source index, so it can tell its own entry in
+    // battery_levels apart from the other peripherals'.
+    uint8_t source;
+    uint8_t layer_index;
+    uint8_t battery_levels[ZMK_SPLIT_STATUS_MAX_PERIPHERALS];
+    uint8_t endpoint_transport;
+    uint8_t active_profile_index;
+    uint8_t profile_flags;
+    uint8_t wpm;
+};
+
+ZMK_EVENT_DECLARE(zmk_split_peripheral_status_data_changed);
