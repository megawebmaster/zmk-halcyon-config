+// Fixed, config-independent size for the peripheral status payload. Central and
+// peripheral are built separately and the peripheral never defines
+// CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS, so a config-dependent array length here
+// would desync the wire format between the two images.
+#define ZMK_SPLIT_STATUS_MAX_PERIPHERALS 4
+
+#define ZMK_SPLIT_STATUS_PROFILE_CONNECTED BIT(0)
+#define ZMK_SPLIT_STATUS_PROFILE_BONDED BIT(1)
+
 enum zmk_split_transport_connections_status {
     ZMK_SPLIT_TRANSPORT_CONNECTIONS_STATUS_DISCONNECTED = 0,
     ZMK_SPLIT_TRANSPORT_CONNECTIONS_STATUS_SOME_CONNECTED,
@@ -61,11 +70,26 @@ struct zmk_split_transport_peripheral_event {
     } data;
 } __packed;
 
+struct zmk_split_peripheral_status_payload {
+    // The recipient's own source index, so it can tell its own entry in battery_levels
+    // apart from the other peripherals'.
+    uint8_t source;
+    uint8_t layer_index;
+    uint8_t battery_levels[ZMK_SPLIT_STATUS_MAX_PERIPHERALS];
+    uint8_t endpoint_transport;
+    uint8_t active_profile_index;
+    uint8_t profile_flags;
+    uint8_t wpm;
+} __packed;
+
 enum zmk_split_transport_central_command_type {
     ZMK_SPLIT_TRANSPORT_CENTRAL_CMD_TYPE_POLL_EVENTS,
     ZMK_SPLIT_TRANSPORT_CENTRAL_CMD_TYPE_INVOKE_BEHAVIOR,
     ZMK_SPLIT_TRANSPORT_CENTRAL_CMD_TYPE_SET_PHYSICAL_LAYOUT,
     ZMK_SPLIT_TRANSPORT_CENTRAL_CMD_TYPE_SET_HID_INDICATORS,
+    // New types must be appended here: the enum is packed and sent over the wire, so
+    // inserting a value renumbers the ones after it and breaks mixed-version splits.
+    ZMK_SPLIT_TRANSPORT_CENTRAL_CMD_TYPE_SET_PERIPHERAL_STATUS,
 } __packed;
 
 struct zmk_split_transport_central_command {
@@ -87,5 +111,7 @@ struct zmk_split_transport_central_command {
         struct {
             zmk_hid_indicators_t indicators;
         } set_hid_indicators;
+
