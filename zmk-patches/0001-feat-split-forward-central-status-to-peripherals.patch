 #include <zmk/events/sensor_event.h>
 #include <zmk/sensors.h>
@@ -103,6 +106,43 @@ static ssize_t split_svc_update_indicators(struct bt_conn *conn, const struct bt
 
 #endif // IS_ENABLED(CONFIG_ZMK_SPLIT_PERIPHERAL_HID_INDICATORS)
 
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_PERIPHERAL_STATUS_REPORTING)
+
+static struct zmk_split_peripheral_status_data_changed peripheral_status = {0};
+
+static void split_svc_peripheral_status_callback(struct k_work *work) {
+    raise_zmk_split_peripheral_status_data_changed(peripheral_status);
+}
+
+static K_WORK_DEFINE(split_svc_peripheral_status_work, split_svc_peripheral_status_callback);
+
+static ssize_t split_svc_peripheral_status(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                                           const void *buf, uint16_t len, uint16_t offset,
+                                           uint8_t flags) {
+    // The payload is fixed size and written whole; a short or offset write would leave
+    // the struct half updated.
+    if (offset != 0 || len != sizeof(struct zmk_split_peripheral_status_payload)) {
+        return BT_GATT_ERR(BT_ATT_ERR_INVALID_ATTRIBUTE_LEN);
+    }
+
+    const struct zmk_split_peripheral_status_payload *payload = buf;
+
+    peripheral_status.source = payload->source;
+    peripheral_status.layer_index = payload->layer_index;
+    peripheral_status.endpoint_transport = payload->endpoint_transport;
+    peripheral_status.active_profile_index = payload->active_profile_index;
+    peripheral_status.profile_flags = payload->profile_flags;
+    peripheral_status.wpm = payload->wpm;
+    memcpy(peripheral_status.battery_levels, payload->battery_levels,
+           sizeof(peripheral_status.battery_levels));
+
+    k_work_submit(&split_svc_peripheral_status_work);
+
+    return len;
+}
+
+#endif // IS_ENABLED(CONFIG_ZMK_SPLIT_PERIPHERAL_STATUS_REPORTING)
+
 static uint8_t selected_phys_layout = 0;
 
 static void split_svc_select_phys_layout_callback(struct k_work *work) {
@@ -201,6 +241,11 @@ BT_GATT_SERVICE_DEFINE(
