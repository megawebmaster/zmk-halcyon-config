//
//        lower_macos_layer {
//            display-name = "MacOS Lower";
//// -----------------------------------------------------------------------------------------------------
//// |  `  |  1  |  2  |  3  |  4  |  5  |                              |  F7  |  F8  |  F9  |  F10  | F11 | F12 |
//// |     |     |     |  {  |  }  |  (  |                              | LEFT | DOWN |  UP  | RIGHT |     |     |
//// |     |     |     |  [  |  ]  |  )  |      |     |         |   |   |      |      |      |       |     |     |
////                   |     |     |     | HOME | END |         |   |   |      |      |      |
//            bindings = <
//&kp GRAVE &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                                                          &kp F7   &kp F8    &kp F9  &kp F10   &kp F11  &kp F12
//&none     &none  &none  &kp LBRC &kp RBRC &kp LPAR                                                        &kp LEFT &kp DOWN  &kp UP  &kp RIGHT &none    &none
//&none     &none  &none  &kp LBKT &kp RBKT &kp RPAR &none        &tog BASE_LNX               &none  &none  &none    &none     &none   &none     &none    &none
//                        &none    &none    &none    &mt LG(LEFT) &mt LG(RIGHT)               &none  &trans &none    &none     &none
//
//&trans &trans &trans &trans &trans                                                                         &trans &trans &trans &trans &trans
